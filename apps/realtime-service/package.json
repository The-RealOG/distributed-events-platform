{
  "name": "@dpp/realtime-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "PORT=3005 tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --disable-warning=TimeoutNegativeWarning dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@dpp/auth": "*",
    "@dpp/config": "*",
    "@dpp/contracts": "*",
    "@dpp/database": "*",
    "@dpp/kafka": "*",
    "@dpp/observability": "*",
    "@dpp/runtime": "*",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dpp/test-utils": "*",
    "@types/ws": "^8.18.2",
    "kafkajs": "^2.2.4"
  }
}
