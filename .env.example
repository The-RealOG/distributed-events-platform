# Copy to .env for running services outside Docker (`npm run dev`).
# Values here are for local development only. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml publishes it on localhost:5432)
POSTGRES_USER=dpp
POSTGRES_PASSWORD=dpp_local_only
POSTGRES_DB=dpp
DATABASE_URL=postgres://dpp:dpp_local_only@localhost:5432/dpp
DATABASE_POOL_MAX=10

# Auth: HS256 secret, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=local-development-only-jwt-secret-000
JWT_ISSUER=dpp-local
JWT_AUDIENCE=dpp-api
JWT_TTL_SECONDS=28800
# Passwordless POST /auth/dev-login. Local development only.
AUTH_DEV_LOGIN_ENABLED=true

# project-service
PORT=3001

# api-gateway (its dev script pins PORT=3000; --env-file never overrides an already-set variable)
PROJECT_SERVICE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPSTREAM_CONNECT_TIMEOUT_MS=2000
UPSTREAM_REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576

# Cloud-only alternatives (set by ECS in AWS; not needed locally):
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD   → combined into DATABASE_URL when it is unset
#   DATABASE_TLS_CA_FILE=/app/certs/rds-global-bundle.pem   → verified TLS to RDS
#   KAFKA_SSL=true KAFKA_AUTH=aws-iam AWS_REGION=us-east-2   → MSK with IAM authentication
